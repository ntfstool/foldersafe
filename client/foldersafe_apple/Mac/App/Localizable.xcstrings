    },
    "Incorrect password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码不正确。"
          }
        }
      }
    },
    "It will contain only encrypted data, so don’t edit it directly — unlock it with FolderSafe to use your files. You can back it up, move it, or sync it like any other folder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "里面只有加密数据，请不要直接改动——用 FolderSafe 解锁后再使用文件。你可以像普通文件夹一样备份、移动或同步它。"
          }
        }
      }
    },
    "I’ve written down all 12 words": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已抄下全部 12 个词"
