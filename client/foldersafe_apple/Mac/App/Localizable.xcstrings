        }
      }
    },
    "Good": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较强"
          }
        }
      }
    },
    "Idle time": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闲置时间"
          }
        }
      }
    },
    "If you forget your password, these 12 words unlock the vault so you can set a new one.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘了密码时，这 12 个词可以解锁保险库，让你设置新密码。"
          }
        }
      }
    },
    "In Finder’s sidebar, under Locations": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达边栏的“位置”下"
