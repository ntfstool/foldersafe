        }
      }
    },
    "For “%@”. Your recovery phrase and Touch ID keep working.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险库“%@”。找回短语和触控 ID 照常可用。"
          }
        }
      }
    },
    "Force Lock": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制上锁"
          }
        }
      }
    },
    "Forgot password? Use recovery phrase": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘了密码？用找回短语"
          }
        }
      }
    },
    "Forgot the password for “%@”? Enter its recovery phrase and choose a new password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘了“%@”的密码？输入它的找回短语，再设置新密码。"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "Go to **General › Login Items & Extensions**, then **File System Extensions**.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往**通用 › 登录项与扩展**，然后点按**文件系统扩展**。"
